{
  "name": "muthuram-complex",
  "version": "1.0.0",
  "private": true,
  "description": "MUTHURAM COMPLEX — premium motorcycle gear & accessories e-commerce platform",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "db:schema": "node scripts/sync-prisma-schema.mjs",
    "db:generate": "prisma generate",
    "db:push": "npm run db:schema && prisma db push",
    "db:migrate": "npm run db:schema && prisma migrate dev",
    "db:studio": "npm run db:schema && prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "npm run db:schema && prisma migrate reset --force",
    "setup": "npm run db:push && npm run db:seed",
    "images:generate": "tsx scripts/generate-placeholder-images.ts",
    "images:real": "node scripts/generate-all-images.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "gsap": "^3.15.0",
    "jose": "^6.1.4",
    "lenis": "^1.3.26",
    "lucide-react": "^0.556.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.7",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  }
}
